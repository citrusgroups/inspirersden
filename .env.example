# Copy to .env.local. Database connection is required for server routes.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only this verified Supabase email receives the Agency Owner role.
AGENCY_OWNER_EMAIL=
# Copy the exact URI from Supabase > Connect > Session pooler (Windows/IPv4).
# Replace [YOUR-PASSWORD] and URL-encode special characters in the password.
DATABASE_URL=
# Set false only when a local/network proxy injects a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Server-only secret; NEVER share it, commit .env.local, or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=agency-private
# Optional: only to import records/files from an earlier local SQLite project.
# DATA_DIR=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# AI Gateway model, for example openai/gpt-5.4-mini.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.4-mini
# Keep false while testing drafts; set true after channel credentials are verified.
AGENT_AUTO_REPLY=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as base64, needed only for social integrations.
TOKEN_ENCRYPTION_KEY=
